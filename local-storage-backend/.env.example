# MinIO S3 Credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=AdminPassword123!
MINIO_DEFAULT_BUCKET=app-images

# Ngrok Free Permanent Static Domain Configuration
# 1. Sign up at https://dashboard.ngrok.com
# 2. Get authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
# 3. Claim free static domain from https://dashboard.ngrok.com/domains
NGROK_AUTHTOKEN=your_ngrok_authtoken_here
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# Active Public URL (Set to https://${NGROK_DOMAIN})
MINIO_SERVER_URL=https://your-static-domain.ngrok-free.app

# Google Gemini AI API Key
# Get yours at: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Debug: print every AI reply (model, category, type, raw text) to the backend log.
# Set to false (or remove) when finished debugging.
DEBUG_AI_RESPONSE=false

# Scan model load balancer (all optional; defaults shown)
# Requests are spread round-robin across these models, each with its own quota.
# GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.6-flash,gemini-3.1-flash-lite,gemma-4-26b-a4b-it
# MODEL_RPM_LIMIT=15
# MODEL_RPD_LIMIT=150
# MODEL_LIMIT_OVERRIDES={"gemma-4-26b-a4b-it":{"rpm":30,"rpd":14400}}
# MODEL_RPD_RESET_TZ=America/Los_Angeles
# SCAN_QUEUE_MAX_SIZE=50
# SCAN_QUEUE_TIMEOUT_MS=30000
# SCAN_REQUEST_DEADLINE_MS=60000
# SCAN_ATTEMPT_TIMEOUT_MS=15000
# SCAN_MAX_ATTEMPTS=4
# SCAN_CIRCUIT_FAILURE_THRESHOLD=3
# SCAN_CIRCUIT_COOLDOWN_MS=60000
# SCAN_CIRCUIT_MAX_COOLDOWN_MS=900000
# SCAN_MODEL_DISABLE_MS=86400000
# Use redis only when running more than one backend instance/worker:
# QUOTA_STORE=memory
# REDIS_URL=redis://redis:6379

# Firebase Admin SDK Credentials
# Get from: Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour-Private-Key-Here\n-----END PRIVATE KEY-----\n"
